#!/bin/bash
# DirAI: serve a folder (the "tree") as agents: every folder holding an index.html is one, browsable
# in the browser, with an AI agent working in it.
# Run it anywhere inside a tree: it acts on the nearest folder at or above you holding www/dirai.json,
# else on the git repo you are in. `DirAI init` sets up that folder, or the current one if neither
# exists; the tree doesn't have to be a git repo.
#
#   DirAI init                 set the tree up: www/dirai.json (port), .gitignore lines, CLAUDE.md import
#   DirAI [start [NODE|--job]] start this tree's server on this machine (default), on NODE,
#                              or as its own sbatch job (--job)
#   DirAI status               is it alive? node, port, job time left, URL
#   DirAI restart              reload in place: same node/port, current code, fresh agent list
#   DirAI stop                 stop this tree's server
#   DirAI build                rebuild this tree's agent list (www/index.html) now
#   DirAI list                 every tree DirAI has started, and whether it is up
#   DirAI connect [SSH...]     print a shell function for your laptop that opens this tree there
#                              (SSH: how you ssh here, e.g. me@host -p 26; remembered in dirai.json)
#   DirAI -C DIR <command>     act on the tree holding DIR instead of the current directory
# Each tree has its own server, port and state (www/), so trees start and stop independently;
# trees may not overlap while running.
set -uo pipefail

TOOL=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
CONFIG_DIR=${DIRAI_CONFIG_DIR:-$HOME/.config/dirai}
TREES_FILE=$CONFIG_DIR/trees
# CLAUDE.md imports the agent rules from this fixed path, a link to this checkout's AGENT_RULE.md, so the
# committed import line is the same on every machine wherever DirAI was cloned (kept fixed even
# when DIRAI_CONFIG_DIR is set, since the import line can't follow it)
RULE_LINK=$HOME/.config/dirai/AGENT_RULE.md
RULE_IMPORT='@~/.config/dirai/AGENT_RULE.md'
# import lines of earlier versions, rewritten to RULE_IMPORT (the file was PAGES.md, and before
# that DirAI had to live in ~/DirAI); the old link is kept too, for trees not started since
OLD_IMPORTS=('@~/DirAI/PAGES.md' '@~/.config/dirai/PAGES.md')
OLD_LINK=$HOME/.config/dirai/PAGES.md
SSH="ssh -o BatchMode=yes -o LogLevel=ERROR -o ConnectTimeout=10"

if [[ "${1:-}" == -C ]]; then cd "${2:?-C needs a directory}" || exit 1; shift 2; fi
CMD=${1:-start}
[[ $# -gt 0 ]] && shift

find_root() {   # the nearest folder at or above here holding www/dirai.json, else the git repo's top
    local d; d=$(pwd -P)
    while :; do
        [[ -s $d/www/dirai.json ]] && { echo "$d"; return 0; }
        [[ $d == / ]] && break
        d=$(dirname "$d")
    done
    git rev-parse --show-toplevel 2>/dev/null
}

case "$CMD" in -h|--help|help) sed -n '2,20p' "$0"; exit 0 ;; list) ;; *)
    ROOT=$(find_root)
    if [[ -z "$ROOT" ]]; then
        [[ "$CMD" == init ]] || { echo "No DirAI tree here or above; run  DirAI init  in the folder to serve (or use DirAI -C DIR)." >&2; exit 1; }
        ROOT=$PWD
    fi
    ROOT=$(cd "$ROOT" && pwd -P)
    DATA=$ROOT/www
    HOST_FILE=$DATA/server_host.txt
    IS_GIT=0; git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 && IS_GIT=1
esac

cfg() {   # cfg KEY [TREE]: a value from the tree's dirai.json (lists space-separated)
    python3 - "$TOOL/lib" "${2:-$ROOT}" "$1" <<'EOF'
import sys; sys.path.insert(0, sys.argv[1]); import dirai_config as c
v = c.tree_config(sys.argv[2]).get(sys.argv[3])
print(" ".join(v) if isinstance(v, list) else ("" if v is None else v))
EOF
}

url_host() {   # node name as reachable from elsewhere (adds this cluster's domain if known)
    local d; d=$(hostname -d 2>/dev/null)
    [[ -n "$d" ]] && echo "$1.$d" || echo "$1"
}

read_host() {
    [[ -s "$HOST_FILE" ]] || return 1
    read -r NODE JOB STARTED_D STARTED_T PID CAP HPORT < "$HOST_FILE"
}

run_on() {   # run_on NODE CMD: on this machine if NODE is this host, else over ssh
    if [[ "$1" == "$(hostname -s)" ]]; then bash -c "$2"; else $SSH "$1" "$2"; fi
}
http_code() {   # http_code NODE PORT TIMEOUT: status of the agent list, asked on the node itself
    # last line only: a login script that echoes over ssh would come first
    run_on "$1" "curl -s -o /dev/null -m $3 -w '%{http_code}' http://127.0.0.1:$2/www/index.html" 2>/dev/null | tail -n 1
}

nested_tree() {   # a running tree inside this one or holding it: both would serve the same agents
    local t
    while read -r t; do
        [[ -n "$t" && "$t" != "$ROOT" && -s "$t/www/server_host.txt" ]] || continue
        [[ "$ROOT" == "$t"/* || "$t" == "$ROOT"/* ]] && { echo "$t"; return 0; }
    done < <(cat "$TREES_FILE" 2>/dev/null)
    return 1
}

port_busy() {   # port_busy NODE PORT: something on NODE already accepts connections there (e.g. an ssh
                # tunnel on 127.0.0.1, which a bind to 0.0.0.0 would not notice)
    run_on "$1" "python3 -c 'import socket,sys; s=socket.socket(); s.settimeout(2); sys.exit(s.connect_ex((\"127.0.0.1\", $2)) != 0)'"
}

update_import() {   # rewrite an earlier version's import line in the tree's CLAUDE.md
    local md=$ROOT/CLAUDE.md old
    for old in "${OLD_IMPORTS[@]}"; do
        if grep -qxF "$old" "$md" 2>/dev/null; then
            sed "s|^$old\$|$RULE_IMPORT|" "$md" > "$md.tmp" && cat "$md.tmp" > "$md" && rm -f "$md.tmp"
            echo "Changed $old to $RULE_IMPORT in CLAUDE.md"
        fi
    done
}

ignore_generated() {   # list DirAI's generated files in the tree's .gitignore (once each)
    local gi=$ROOT/.gitignore line added=0
    [[ $IS_GIT == 1 ]] || return 0
    for line in www/dirai.json www/index.html www/server_host.txt 'www/serve_node*.log' www/agents.json \
                www/agent_sizes.json www/agent_sizes.json.lock www/agent_tokens.json 'www/*.tmp' www/before_run/; do
        grep -qxF "$line" "$gi" 2>/dev/null || { [[ $added == 0 ]] && echo "# generated by DirAI" >> "$gi"; echo "$line" >> "$gi"; added=1; }
    done
    [[ $added == 1 ]] && echo "Added DirAI's generated files to .gitignore"
    return 0
}

register() {   # on init and start: the rules link, CLAUDE.md, .gitignore, the list of trees
    mkdir -p "$CONFIG_DIR" "$(dirname "$RULE_LINK")"
    ln -sfn "$TOOL/AGENT_RULE.md" "$RULE_LINK"   # repoint it if this checkout moved
    ln -sfn "$TOOL/AGENT_RULE.md" "$OLD_LINK"
    update_import
    ignore_generated
    grep -qxF "$ROOT" "$TREES_FILE" 2>/dev/null || echo "$ROOT" >> "$TREES_FILE"
}

status() {
    local port; port=$(cfg port)
    echo "tree:    $ROOT"
    if ! read_host; then
        echo "DOWN: no $HOST_FILE (server not running, or started <30 s ago)"
        return 1
    fi
    echo "node:    $NODE"
    echo "url:     http://$(url_host "$NODE"):${HPORT:-$port}/www/index.html"
    echo "started: $STARTED_D $STARTED_T"
    if [[ "$JOB" != nojob ]]; then
        local left; left=$(PYTHONPATH=$TOOL/lib python3 -c 'import sys, slurm as p
j = [j for j in p.active_jobs() or [] if j["id"] == sys.argv[1]]
print("%s, %s left" % (j[0]["state"], j[0]["left"]) if j else "")' "$JOB" 2>/dev/null)   # sacct: squeue is slow here
        echo "job:     $JOB (${left:-not in queue anymore})"
    fi
    echo "list:    built $(date -r "$DATA/index.html" '+%F %T' 2>/dev/null || echo never)"
    local code; code=$(http_code "$NODE" "${HPORT:-$port}" 5)
    [[ "$code" == 200 ]] && { echo "ALIVE"; return 0; }
    echo "NOT ANSWERING (${code:-no answer})"; return 1
}

port_in_use_by_other_tree() {   # another registered tree with the same port that is up
    local port=$1 t
    while read -r t; do
        [[ -n "$t" && "$t" != "$ROOT" && -s "$t/www/server_host.txt" ]] || continue
        [[ "$(cfg port "$t")" == "$port" ]] && { echo "$t"; return 0; }
    done < <(cat "$TREES_FILE" 2>/dev/null)
    return 1
}

start() {
    [[ -s "$DATA/dirai.json" ]] || { echo "This tree isn't set up yet: run  DirAI init  first." >&2; return 1; }
    local port other; port=$(cfg port)
    if read_host && status >/dev/null 2>&1; then echo "Already running on $NODE:${HPORT:-$port}"; return 0; fi
    if other=$(port_in_use_by_other_tree "$port"); then
        echo "Port $port is already used by $other; change \"port\" in $DATA/dirai.json." >&2; return 1
    fi
    if other=$(nested_tree); then
        echo "$other is running and overlaps this tree (one would serve the other's agents); stop it first: DirAI -C $other stop" >&2; return 1
    fi
    register
    if [[ "${1:-}" == --job ]]; then
        # extra sbatch options (account, partition, time) from dirai.json "slurm", e.g. ["-A","grp","-p","cpu"]
        sbatch -J "dirai-$(basename "$ROOT")" -n 1 -c 1 --mem=2G -o "$DATA/serve_node.%j.log" \
            $(cfg slurm) "$TOOL/bin/dirai_serve" "$ROOT"
        return
    fi
    local node=${1:-}
    [[ -z "$node" || "$node" == --here ]] && node=$(hostname -s)   # default: where DirAI was run
    if run_on "$node" "pgrep -u $USER -f '[d]irai_serve $ROOT\$' >/dev/null"; then
        echo "Already running on $node (server_host.txt may take ~30 s to show up)"; return 0
    fi
    if port_busy "$node" "$port"; then
        echo "Port $port on $node is already taken by another program (an ssh tunnel? see: lsof -nP -iTCP:$port -sTCP:LISTEN); change \"port\" in $DATA/dirai.json." >&2
        return 1
    fi
    # own session, so it outlives this shell and its stop (kill 0) reaches only itself; macOS has no
    # setsid command, so fall back to Python's os.setsid there
    run_on "$node" "if command -v setsid >/dev/null; then S=setsid; else S='python3 -c \"import os,sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])\"'; fi;
        eval \"\$S nohup '$TOOL/bin/dirai_serve' '$ROOT' > '$DATA/serve_node.log' 2>&1 < /dev/null &\"" &&
        echo "Started $ROOT on $node:$port (log: $DATA/serve_node.log)"
    SECONDS=0
    while (( SECONDS < 120 )); do
        [[ "$(http_code "$node" "$port" 3)" == 200 ]] &&
            { echo "Up: http://$(url_host "$node"):$port/www/index.html"
              echo "To open it from your laptop: DirAI connect (prints a shell function to paste there)"
              return 0; }
        sleep 2
    done
    echo "Not answering after 2 min; check $DATA/serve_node.log" >&2; return 1
}

restart() {
    local port; port=$(cfg port)
    read_host || { echo "Not running (no $HOST_FILE). Start it with: DirAI start"; return 1; }
    run_on "$NODE" "kill -USR1 $PID" || return 1
    sleep 2
    SECONDS=0
    while (( SECONDS < 180 )); do   # ask the node directly: server_host.txt can lag on NFS
        [[ "$(http_code "$NODE" "${HPORT:-$port}" 3)" == 200 ]] &&
            { echo "Back up on $NODE after $((SECONDS + 2)) s"; return 0; }
        sleep 2
    done
    echo "Not answering after 3 min; check: DirAI status" >&2; return 1
}

stop() {
    read_host || { echo "Not running"; return 0; }
    run_on "$NODE" "kill -TERM $PID"     # its cleanup trap stops the Python server
    if [[ "$JOB" != nojob ]] && [[ "$(sacct -X -n -P -j "$JOB" --state=PENDING,RUNNING -o JobName 2>/dev/null)" == dirai-* ]]; then
        scancel "$JOB"   # its own job; never cancels a job you started for something else
    fi
    rm -f "$HOST_FILE"
    echo "Stopped $ROOT"
}

init() {
    local home; home=$(cd "$HOME" && pwd -P)
    if [[ "$ROOT" == / || "$ROOT" == "$home" ]]; then
        echo "Refusing to serve $ROOT: its agents could read everything in it. Pick a project folder." >&2; return 1
    fi
    mkdir -p "$DATA"
    if [[ ! -s "$DATA/dirai.json" ]]; then
        local used port t
        used=$(while read -r t; do [[ -n "$t" ]] && cfg port "$t"; done < <(cat "$TREES_FILE" 2>/dev/null))
        port=8765
        while grep -qxF "$port" <<<"$used" || port_busy "$(hostname -s)" "$port"; do port=$((port + 1)); done
        printf '{\n "port": %d,\n "read_dirs": [],\n "allow": []\n}\n' "$port" > "$DATA/dirai.json"
        echo "Wrote $DATA/dirai.json (port $port; local to this clone, not committed)."
    fi
    local md=$ROOT/CLAUDE.md ans
    update_import
    if ! grep -qxF "$RULE_IMPORT" "$md" 2>/dev/null; then
        # outside git, CLAUDE.md here reaches every project below (e.g. all of ~/work): ask first
        ans=y
        if [[ $IS_GIT == 0 ]]; then
            ans=n
            [[ -t 0 ]] && read -r -p "Add $RULE_IMPORT to $md? It applies the agent rules to every Claude session under $ROOT. [y/N] " ans
        fi
        if [[ $ans == [yY]* ]]; then
            printf '\n%s\n' "$RULE_IMPORT" >> "$md"
            echo "Added $RULE_IMPORT to CLAUDE.md (agent conventions for Claude sessions)"
        else
            echo "Left CLAUDE.md alone (agents get the rules anyway; to add them for your own sessions: echo '$RULE_IMPORT' >> $md)"
        fi
    fi
    register
    echo "Ready. Start it with: DirAI start"
}

connect() {   # print a shell function (bash or zsh) for the owner's laptop: tunnel + login + open
    local word dest name key_file=$CONFIG_DIR/key port
    [[ $# -gt 0 ]] && dest="$*" || dest=$(cfg ssh)
    if [[ -z "$dest" ]]; then   # a guess: this host as it names itself, and the port this ssh came in on
        dest="$USER@$(hostname -f 2>/dev/null || hostname)"
        local in_port; in_port=$(awk '{print $4}' <<<"${SSH_CONNECTION:-}")
        [[ -n "$in_port" && "$in_port" != 22 ]] && dest="$dest -p $in_port"
        echo "# Guessed how you ssh here: $dest" >&2
        echo "# If your laptop reaches this machine differently (an alias, another address or port), run" >&2
        echo "#   DirAI connect <what you type after ssh>    e.g.  DirAI connect me@100.90.173.94 -p 26" >&2
        echo >&2
    fi
    for word in $dest; do   # it goes into the function as code: plain words only
        [[ "$word" =~ ^[A-Za-z0-9@._:=/~+-]+$ ]] || { echo "DirAI connect: unusual characters in \"$word\"" >&2; return 1; }
    done
    [[ "$ROOT$key_file" != *"'"* ]] || { echo "DirAI connect: the tree path contains a quote" >&2; return 1; }
    if [[ $# -gt 0 ]]; then   # how the owner sshes here: remember it for next time
        python3 - "$TOOL/lib" "$ROOT" "$dest" <<'EOF'
import sys; sys.path.insert(0, sys.argv[1]); import dirai_config as c
c.set_tree_option(sys.argv[2], "ssh", sys.argv[3])
EOF
    fi
    port=$(cfg port)
    name=dirai-$(basename "$ROOT" | tr -c 'A-Za-z0-9_\n' '_')
    cat <<EOF
# Paste into ~/.zshrc or ~/.bashrc on your laptop, then run: $name [LOCAL_PORT]
# Generated by DirAI connect for the tree $ROOT. Opens its agent list logged in as the owner.
# Browser: your default, or set DIRAI_BROWSER (e.g. export DIRAI_BROWSER="Google Chrome").
$name() {
  local lport="\${1:-$port}" info key node port user here url
  info=\$(ssh $dest "cat '$key_file' && { cat '$ROOT/www/server_host.txt' 2>/dev/null || echo; } && whoami && hostname -s") ||
    { echo "Can't reach the tree's machine with: ssh $dest"; return 1; }
  { read -r key; read -r node _ _ _ _ _ port; read -r user; read -r here; } <<<"\$info"
  [ -n "\$port" ] || { echo "DirAI isn't running for $ROOT (start it there: DirAI start)"; return 1; }
  url="http://127.0.0.1:\$lport"   # the tunnel's local end
  ( ( for i in {1..30}; do
        curl -s -o /dev/null "\$url/www/index.html" 2>/dev/null || { sleep 1; continue; }
        if [ "\$(uname)" = Darwin ]; then open \${DIRAI_BROWSER:+-a "\$DIRAI_BROWSER"} "\$url/_review/login?key=\$key"
        else "\${DIRAI_BROWSER:-xdg-open}" "\$url/_review/login?key=\$key"; fi
        exit
      done ) & )
  echo "Tunnel to $ROOT on \$node (local port \$lport; Ctrl-C closes it, the server keeps running)"
  while :; do
    if [ "\$node" = "\$here" ]; then   # the server runs on the machine you ssh to
      ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \\
          -L "\$lport:localhost:\$port" $dest
    else                             # on another node: through this one, to that node's own loopback
      ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \\
          -o "ProxyCommand=ssh $dest -W %h:%p" -L "\$lport:localhost:\$port" "\$user@\$node"
    fi
    [ \$? -eq 255 ] || break         # 255: the connection dropped (or the local port is taken)
    echo "Connection lost; reconnecting in 5 s (Ctrl-C to stop)..."
    sleep 5
  done
}
EOF
}

list() {
    local t port
    [[ -s "$TREES_FILE" ]] || { echo "No trees yet (run DirAI init in a repo)."; return 0; }
    while read -r t; do
        [[ -n "$t" ]] || continue
        port=$(cfg port "$t")
        if [[ -s "$t/www/server_host.txt" ]]; then
            read -r n j _ _ _ _ _ < "$t/www/server_host.txt"
            printf '%-6s %-5s %-8s %s\n' up "$port" "$n" "$t"
        else
            printf '%-6s %-5s %-8s %s\n' down "$port" - "$t"
        fi
    done < "$TREES_FILE"
}

case "$CMD" in
    start)   start "${1:-}" ;;
    status)  status ;;
    restart) restart ;;
    stop)    stop ;;
    build)   python3 "$TOOL/lib/agent_list.py" "$ROOT" ;;
    init)    init ;;
    list)    list ;;
    connect) connect "$@" ;;
    *) sed -n '2,18p' "$0"; exit 1 ;;
esac
